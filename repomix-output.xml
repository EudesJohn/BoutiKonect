  left: var(--space-sm);
  display: flex;
  gap: var(--space-xs);
  flex-wrap: wrap;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
}

.badge-primary {
  background: linear-gradient(135deg, #FF6A00, #FF8C00);
  color: white;
}

.badge-danger {
  background: linear-gradient(135deg, #F44336, #D32F2F);
  color: white;
}

.badge-warning {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  color: white;
}

.badge-promoted {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #1e2a4a;
  animation: pulse-gold 2s infinite;
}

.badge-service {
  background: linear-gradient(135deg, #00C853, #64DD17);
  color: white;
}

.price-label {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-light);
  margin-right: 4px;
}

@keyframes pulse-gold {
  0%, 100% { box-shadow: 0 0 5px rgba(255, 215, 0, 0.5); }
  50% { box-shadow: 0 0 15px rgba(255, 215, 0, 0.8); }
}

.image-zoom-hint {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  padding: 5px 10px;
  border-radius: 20px;
  font-size: 10px;
  display: flex;
  align-items: center;
  gap: 5px;
  backdrop-filter: blur(4px);
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.3s;
}

.product-image:hover .image-zoom-hint {
  opacity: 1;
}

.wishlist-btn {
  position: absolute;
  top: var(--space-sm);
  right: var(--space-sm);
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0d1b2a;
  border: 2px solid #FF6A00;
  border-radius: var(--radius-full);
  color: var(--text-light);
  transition: var(--transition-fast);
  cursor: pointer;
}

.wishlist-btn:hover {
  color: #FF1744;
  transform: scale(1.1);
}

.product-views {
  position: absolute;
  bottom: var(--space-sm);
  left: var(--space-sm);
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  background: rgba(0, 0, 0, 0.7);
  border-radius: var(--radius-sm);
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
}

.product-content {
  padding: var(--space-md);
}

.product-category {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  color: #FF6A00;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: var(--space-xs);
}

.product-title {
  display: block;
  font-size: 1.15rem;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: var(--space-xs);
  line-height: 1.3;
  transition: var(--transition-fast);
  text-decoration: none;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.product-title:hover {
  color: #FFD700;
  transform: translateX(4px);
}

.product-description {
  font-size: 0.85rem;
  color: var(--text-light);
  line-height: 1.5;
  margin-bottom: var(--space-sm);
}

.product-location {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  font-size: 0.8rem;
  color: var(--text-light);
  margin-bottom: var(--space-sm);
}

.product-location svg {
  color: #FF6A00;
}

.product-price {
  font-size: 1.25rem;
  font-weight: 800;
  color: #FF6A00;
  margin-bottom: var(--space-md);
  text-shadow: 0 0 10px rgba(255, 106, 0, 0.2);
}

.product-actions {
  display: flex;
  gap: var(--space-sm);
}

.product-actions .btn {
  flex: 1;
  justify-content: center;
}

.product-actions .btn-outline {
  border-color: #FF6A00;
  color: #FF6A00;
  background: transparent;
}

.product-actions .btn-outline:hover {
  background: rgba(255, 106, 0, 0.15);
}

/* Responsive */
@media (max-width: 480px) {
  .product-image {
    height: 180px;
  }

  .product-content {
    padding: var(--space-sm);
  }

  .product-actions {
    flex-direction: column;
  }

  .product-actions .btn {
    width: 100%;
  }
}
