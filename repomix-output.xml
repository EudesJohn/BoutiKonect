}

.form-hint {
  color: #5a7a9a;
  font-size: 12px;
}

.form-nav {
  display: flex;
  gap: 15px;
  margin-top: 10px;
}

.form-nav .btn {
  flex: 1;
}

.btn {
  padding: 12px 24px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  font-size: 14px;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6A00 0%, #FF8C00 100%);
  color: white;
  border: none;
  box-shadow: 0 4px 15px rgba(255, 106, 0, 0.4);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255, 106, 0, 0.5);
}

.btn-outline {
  background: transparent;
  color: #FF6A00;
  border: 2px solid #FF6A00;
}

.btn-outline:hover {
  background: rgba(255, 106, 0, 0.1);
}

.btn-ghost {
  background: transparent;
  color: var(--text-light);
  border: none;
}

.btn-ghost:hover {
  color: #ffffff;
}

.btn-large {
  padding: 16px 32px;
  font-size: 16px;
}

.btn-small {
  padding: 8px 16px;
  font-size: 13px;
}

.register-footer {
  text-align: center;
  margin-top: 24px;
  padding-top: 24px;
  border-top: 2px solid #2a3f5f;
}

.register-footer p {
  color: var(--text-light);
  font-size: 14px;
}

.register-footer a {
  color: #FF6A00;
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s;
}

.register-footer a:hover {
  color: #FF8C00;
}

@media (max-width: 480px) {
  .register-card {
    padding: 28px 20px;
    border-radius: 20px;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .register-header h1 {
    font-size: 22px;
  }
  
  .register-header p {
    font-size: 13px;
  }
  
  .form-input, .form-select {
    padding: 12px 14px;
    font-size: 14px;
  }
  
  .btn-large {
    padding: 14px 24px;
    font-size: 15px;
  }
}
