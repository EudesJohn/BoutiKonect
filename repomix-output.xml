}

.orders-table td {
  font-size: 0.9rem;
}

/* Reports */
.reports-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.report-card {
  background: rgba(255, 23, 68, 0.05);
  border: 1px solid rgba(255, 23, 68, 0.2);
  border-radius: var(--radius-lg);
  padding: 20px;
}

.report-product {
