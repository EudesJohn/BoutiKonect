  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  box-shadow: 0 10px 30px rgba(0, 200, 83, 0.4);
}

.success-icon svg {
  color: white;
}

.success-container h2 {
  color: #00C853;
  font-size: 24px;
  margin-bottom: 10px;
}

.success-container p {
  color: var(--text-light);
  font-size: 14px;
}

.register-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-step {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.form-group {
  display: flex;
