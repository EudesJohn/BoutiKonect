<file path="frontend/src/pages/ForgotPassword/ForgotPassword.css">
.forgot-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #0d1b2a 0%, #1b263b 50%, #1e3a5f 100%);
}

.forgot-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #0d1b2a 0%, #1b263b 50%, #1e3a5f 100%);
  z-index: -2;
}

.forgot-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(255, 106, 0, 0.4) 0%, rgba(255, 140, 0, 0.2) 30%, transparent 70%);
  z-index: -1;
  animation: pulse-glow 4s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
}

.forgot-card {
  background: linear-gradient(145deg, #1e2a4a 0%, #152238 100%);
  border: 2px solid #FF6A00;
  border-radius: 24px;
  padding: 48px;
  width: 100%;
  max-width: 440px;
  box-shadow: 0 25px 50px -12px rgba(255, 106, 0, 0.3), 0 0 30px rgba(255, 106, 0, 0.1);
}

.forgot-header {
  text-align: center;
  margin-bottom: 32px;
}

.forgot-icon {
  width: 64px;
  height: 64px;
  background: linear-gradient(135deg, #FF6A00 0%, #FF8C00 100%);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  box-shadow: 0 10px 30px rgba(255, 106, 0, 0.4);
}

.forgot-icon svg {
  color: white;
}

.forgot-header h1 {
  font-size: 24px;
  font-weight: 700;
  color: #FF6A00;
  margin-bottom: 8px;
  text-shadow: 0 0 20px rgba(255, 106, 0, 0.5);
}

.forgot-header p {
  color: var(--text-light);
  font-size: 14px;
  line-height: 1.5;
}

.success-alert {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 20px;
  background: rgba(0, 200, 83, 0.15);
  border: 1px solid #00C853;
  border-radius: 12px;
  color: #00C853;
}

.success-alert strong {
  display: block;
  margin-bottom: 4px;
}

.success-alert p {
  color: var(--text-light);
  font-size: 14px;
  margin: 0;
}

.forgot-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #FF6A00;
  font-size: 14px;
  font-weight: 600;
}

.form-label svg {
  color: #FF6A00;
}

.form-input {
  width: 100%;
  padding: 14px 16px;
  background: #0d1b2a;
  border: 2px solid #FF6A00;
  border-radius: 12px;
  color: #FFD700;
  font-size: 15px;
  font-weight: 600;
  transition: all 0.3s ease;
}

.form-input::placeholder {
  color: var(--text-light);
  font-weight: 400;
}

.form-input:focus {
  outline: none;
  border-color: #FF6A00;
  box-shadow: 0 0 0 3px rgba(255, 106, 0, 0.25), 0 0 15px rgba(255, 106, 0, 0.2);
}

.form-input.error {
  border-color: #FF1744;
}

.error-text {
  color: #FF1744;
  font-size: 12px;
  font-weight: 500;
}

.forgot-alternative {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 2px solid #2a3f5f;
  text-align: center;
}

.forgot-alternative p {
  color: var(--text-light);
  font-size: 14px;
  margin-bottom: 16px;
}

.btn-whatsapp {
  background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
  color: white;
  border: none;
  padding: 14px 24px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
}

.btn-whatsapp:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
}

.forgot-footer {
  text-align: center;
  margin-top: 24px;
  padding-top: 24px;
  border-top: 2px solid #2a3f5f;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #FF6A00;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: color 0.2s;
  text-shadow: 0 0 10px rgba(255, 106, 0, 0.3);
}

.back-link:hover {
  color: #FF8C00;
  text-shadow: 0 0 15px rgba(255, 106, 0, 0.5);
}

/* Button styles */
.btn {
  padding: 12px 24px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  font-size: 14px;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6A00 0%, #FF8C00 100%);
  color: white;
  border: none;
  box-shadow: 0 4px 15px rgba(255, 106, 0, 0.4);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255, 106, 0, 0.5);
}

.btn-primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-large {
  padding: 16px 32px;
  font-size: 16px;
}

@media (max-width: 480px) {
  .forgot-card {
    padding: 32px 24px;
  }

  .forgot-header h1 {
    font-size: 22px;
  }
}

.email-display {
  width: 100%;
  padding: 14px 16px;
  background: #0d1b2a;
  border: 2px solid #28a745;
  border-radius: 12px;
  color: #FFD700;
  font-size: 15px;
  font-weight: 600;
}

.email-hint {
  color: var(--text-light);
  font-size: 12px;
  font-style: italic;
}

.temp-password-info {
  background: linear-gradient(135deg, #1a3a5c 0%, #0d2840 100%);
  border: 2px solid #28a745;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 20px;
}

.temp-password-header {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #28a745;
  font-weight: 600;
  margin-bottom: 8px;
}

.temp-password-info p {
  color: var(--text-light);
  font-size: 13px;
  margin: 0;
  line-height: 1.5;
}

/* OTP Styles */
.security-notice {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1));
  border: 1px solid rgba(99, 102, 241, 0.2);
  border-radius: 12px;
  margin-bottom: 1.5rem;
}

.security-notice svg {
  color: #6366f1;
  flex-shrink: 0;
}

.security-notice p {
  font-size: 0.9rem;
  color: #6366f1;
  margin: 0;
  line-height: 1.4;
}

.otp-verification {
  padding: 1rem 0;
}

.otp-info {
  text-align: center;
  padding: 1.5rem;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(22, 163, 74, 0.1));
  border-radius: 12px;
  margin-bottom: 1.5rem;
}

.otp-icon {
  color: #22c55e;
  margin-bottom: 0.75rem;
}

.otp-info p {
  margin: 0;
  color: var(--text-light);
  font-size: 0.95rem;
}

.otp-timer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
  font-weight: 600;
  color: #f59e0b;
}

.otp-input {
  text-align: center;
  font-size: 1.5rem;
  letter-spacing: 0.5rem;
  font-weight: 600;
}

.password-sent {
  padding: 1rem 0;
}

.otp-success {
  text-align: center;
  padding: 2rem 1rem;
}

.success-icon {
  color: #22c55e;
  margin-bottom: 1rem;
}

.otp-success h3 {
  font-size: 1.5rem;
  color: #22c55e;
  margin: 0 0 0.5rem 0;
}

.otp-success p {
  color: var(--text-light);
  margin: 0;
}

.btn-secondary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: white;
  border: none;
  padding: 0.875rem 1.5rem;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
}

.btn-secondary:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
}

.btn-secondary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.btn-link {
  background: transparent;
  color: #6366f1;
  border: none;
  padding: 0.75rem;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  margin-top: 0.5rem;
}

.btn-link:hover:not(:disabled) {
  color: #4f46e5;
  text-decoration: underline;
}

.btn-link:disabled {
  color: #9ca3af;
  cursor: not-allowed;
}

/* New password section */
.new-password-section {
  padding: 1rem 0;
}

.new-password-section .otp-success {
  text-align: center;
  padding: 1.5rem;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(22, 163, 74, 0.1));
  border-radius: 12px;
  margin-bottom: 1.5rem;
}

.new-password-section .success-icon {
  color: #22c55e;
  margin-bottom: 0.5rem;
}

.new-password-section h3 {
  font-size: 1.25rem;
  color: #22c55e;
  margin: 0 0 0.5rem 0;
}

.new-password-section .otp-success p {
  color: var(--text-light);
  margin: 0;
  font-size: 0.9rem;
}

.password-input-wrapper {
  position: relative;
}

.password-toggle {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: none;
  color: var(--text-light);
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.password-toggle:hover {
  color: #FF6A00;
}

.error-alert {
  background: rgba(244, 67, 54, 0.1);
  border: 1px solid #F44336;
  border-radius: 8px;
  padding: 12px;
  color: #F44336;
  font-size: 14px;
  text-align: center;
}

/* Waiting verification */
.waiting-verification {
  text-align: center;
  padding: 2rem 1rem;
}

.waiting-icon {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  animation: pulse-waiting 2s ease-in-out infinite;
}

@keyframes pulse-waiting {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

.waiting-icon svg {
  color: white;
}

.waiting-verification h3 {
  font-size: 1.25rem;
  color: #f59e0b;
  margin: 0 0 0.5rem 0;
}

.waiting-verification p {
  color: var(--text-light);
  margin: 0 0 1rem 0;
}

.request-id {
  background: #0d1b2a;
  padding: 8px 16px;
  border-radius: 8px;
  font-family: monospace;
  color: #FF6A00;
  font-size: 14px;
  margin-bottom: 1.5rem;
}

.admin-response {
  margin-bottom: 1.5rem;
}

.help-text {
  color: var(--text-light);
  font-size: 0.875rem;
  margin-bottom: 1rem;
}
