}

/* Orders Section */
.orders-section {
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.seller-orders-group {
  background: linear-gradient(145deg, rgba(30, 42, 74, 0.9) 0%, rgba(21, 34, 56, 0.9) 100%);
