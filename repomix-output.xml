  gap: 15px;
  margin-bottom: 15px;
}

.report-product img {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: var(--radius-md);
}

.report-info h3 {
  color: #FFD700;
  margin-bottom: 5px;
}

.report-info p {
  color: var(--text-light);
  font-size: 0.9rem;
  margin-bottom: 5px;
}

.seller-info {
