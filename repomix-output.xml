    align-items: flex-start;
  }
  
  .admin-table-container table {
    min-width: 700px;
  }
}

@media (max-width: 480px) {
  .admin-stats {
    grid-template-columns: 1fr;
  }
  
  .admin-header h1 {
    font-size: 1.5rem;
  }
