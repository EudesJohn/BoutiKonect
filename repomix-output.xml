  font-weight: 700;
  font-size: 1.1rem;
  margin-bottom: var(--space-xs);
}

.quick-seller {
  color: var(--text-light);
  font-size: 0.85rem;
  margin-bottom: var(--space-md);
}

.whatsapp-btn-quick {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  width: 100%;
  padding: var(--space-sm) var(--space-md);
  background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
  color: white;
  border-radius: var(--radius-md);
  font-weight: 600;
  text-decoration: none;
  transition: var(--transition-fast);
}

.whatsapp-btn-quick:hover {
  transform: scale(1.02);
  box-shadow: 0 10px 30px rgba(37, 211, 102, 0.4);
}

.contact-instructions {
  background: linear-gradient(145deg, #1e2a4a 0%, #152238 100%);
  border: 2px solid #FF6A00;
  border-radius: var(--radius-xl);
  padding: var(--space-2xl);
  text-align: center;
}

.contact-instructions h3 {
  color: #FF6A00;
  margin-bottom: var(--space-lg);
}

.contact-instructions ol {
  list-style: none;
  max-width: 400px;
  margin: 0 auto var(--space-xl);
  text-align: left;
}

.contact-instructions li {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  color: var(--text-light);
  border-bottom: 1px solid #2a3f5f;
}

.contact-instructions li:last-child {
  border-bottom: none;
}

.step-number {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6A00 0%, #FF8C00 100%);
  color: white;
  font-weight: 700;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.contact-instructions a {
  color: #FF6A00;
}

.contact-instructions .btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
}

/* Responsive */
@media (max-width: 768px) {
  .messages-layout {
    grid-template-columns: 1fr;
    height: auto;
  }

  .conversations-list {
    height: 300px;
  }

  .chat-area {
    min-height: 400px;
  }
  
  .products-grid-quick {
    grid-template-columns: 1fr;
  }
}
