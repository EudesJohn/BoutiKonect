  }

  .seller-products h2 {
    font-size: 1rem;
  }

  .seller-product-card {
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .seller-product-card img {
    width: 50px;
    height: 50px;
  }

  .seller-product-card .product-info {
    flex: 1 1 calc(100% - 70px);
  }

  .seller-product-card .product-actions {
    width: 100%;
    justify-content: flex-end;
    margin-top: var(--space-xs);
  }

  .no-products {
    padding: var(--space-lg);
  }

  .no-products svg {
    width: 36px;
    height: 36px;
  }
}

/* Very small screens */
@media (max-width: 400px) {
  .publish-card {
    padding: var(--space-sm);
  }

  .publish-header h1 {
    font-size: 1.1rem;
  }

  .image-preview {
    width: 60px;
    height: 60px;
  }

  .seller-product-card .product-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .seller-product-card .btn {
    width: 100%;
    justify-content: center;
  }
}

/* ============ PROMOTE MODAL STYLES ============ */
.promote-modal {
  max-width: 450px;
}

.promote-modal .modal-header {
  display: flex;
  justify-content: space-between;
