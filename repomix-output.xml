  font-size: 0.85rem;
}

.report-reasons h4 {
  color: #FFD700;
  margin-bottom: 10px;
}

.report-item {
  background: rgba(13, 27, 42, 0.5);
  padding: 10px 15px;
  border-radius: var(--radius-md);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
}

.report-item p {
  color: var(--text-light);
  flex: 1;
}

.report-date {
  color: #666;
  font-size: 0.85rem;
  margin-right: 10px;
}

.btn-resolve {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 12px;
  background: rgba(0, 200, 83, 0.2);
  border: 1px solid rgba(0, 200, 83, 0.3);
  border-radius: var(--radius-sm);
  color: #00C853;
  font-size: 0.85rem;
  cursor: pointer;
  transition: var(--transition-fast);
}

.btn-resolve:hover {
  background: #00C853;
  color: white;
}

.report-actions {
  margin-top: 15px;
  padding-top: 15px;
  border-top: 1px solid rgba(255, 23, 68, 0.2);
}

.btn-delete-product {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: rgba(255, 23, 68, 0.2);
  border: none;
  border-radius: var(--radius-md);
  color: #FF1744;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition-fast);
}

.btn-delete-product:hover {
  background: #FF1744;
  color: white;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
